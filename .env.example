# ── Backend (Spring Boot) ──────────────────────────────────────────────────
# Copy to .env and `export $(grep -v '^#' .env | xargs)` before `./gradlew bootRun`,
# or set these in your host's environment (Render, Fly, ECS task def, systemd unit…).

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/mmv
DATABASE_USERNAME=mmv
DATABASE_PASSWORD=mmv

# Studio admin accounts (two people; passwords are hashed on boot)
ADMIN_ERICA_PASSWORD=change-me
ADMIN_AUSTIN_PASSWORD=change-me

# JWT signing secret — at least 32 chars. Generate: openssl rand -base64 48
APP_JWT_SECRET=

# Where the website is served from (CORS + links in notification emails)
APP_SITE_URL=https://www.memoriesmadevisible.com
APP_CORS_ORIGINS=https://www.memoriesmadevisible.com

# Booking-request notifications
NOTIFY_TO=            # TBD — the studio inbox; comma-separate for more than one
NOTIFY_FROM=no-reply@memoriesmadevisible.com
NOTIFY_CUSTOMER=false # also send the customer an acknowledgement email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Photo storage (S3). Credentials come from the standard AWS chain:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, a profile, or an instance/task role.
S3_BUCKET=mmv-photos
AWS_REGION=us-east-1
S3_PUBLIC_BASE_URL=   # e.g. https://d1234.cloudfront.net or https://mmv-photos.s3.amazonaws.com
S3_KEY_PREFIX=        # optional folder inside the bucket
# Local MinIO only:
# S3_ENDPOINT=http://localhost:9000
# S3_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minio123
